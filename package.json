{
	"name": "atelier-freshrss-theme",
	"version": "1.6.0",
	"description": "Tooling for the Atelier theme for FreshRSS. The theme itself needs none of this: a folder is copied into p/themes/ and read by a browser.",
	"private": true,
	"license": "AGPL-3.0-or-later",
	"scripts": {
		"stylelint": "stylelint 'src/**/*.css' 'Atelier/**/*.css'",
		"stylelint_fix": "stylelint --fix 'src/**/*.css' 'Atelier/**/*.css'",
		"svgo": "svgo --quiet --folder src/icons"
	},
	"devDependencies": {
		"@stylistic/stylelint-plugin": "^5.3.1",
		"stylelint": "^17.15.0",
		"stylelint-config-recommended": "^18.0.0",
		"stylelint-order": "^8.1.1",
		"svgo": "^4.1.0"
	}
}
